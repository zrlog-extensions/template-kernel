<#if pager?? && (pager.pageList![])?size gt 1><nav class="pagination" aria-label="${(_res.pagination!'Pagination')?html}"><span>page</span><#list pager.pageList as item><a href="${item.url?html}"<#if !(item.current!false)><#if item.prev!false> rel="prev"<#elseif item.next!false> rel="next"</#if></#if><#if item.current!false> aria-current="page"</#if>>[${item.desc?html}]</a></#list></nav></#if>
